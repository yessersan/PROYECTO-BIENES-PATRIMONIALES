+  font-weight: 600;
+  font-size: 0.9rem;
+  text-transform: uppercase;
+  letter-spacing: 0.05em;
+  padding: 0.5rem 0;
+}
+
+.navigation-menu .p-panelmenu-content {
+  background: none;
+  border: none;
+  padding: 0;
+}
+
+.navigation-menu .p-menuitem-link {
+  padding: 0.875rem 1rem;
+  margin-bottom: 0.25rem;
+  border-radius: 0.5rem;
+  transition: var(--transition);
+  display: flex;
+  align-items: center;
+  gap: 0.75rem;
+  color: var(--text-color);
+  text-decoration: none;
+}
+
+.navigation-menu .p-menuitem-link:hover {
+  background-color: var(--hover-color);
+}
+
+.navigation-menu .p-menuitem-link.router-link-active {
+  background-color: var(--primary-color);
+  color: white;
+}
+
+.navigation-menu .p-menuitem-icon {
+  font-size: 1.1rem;
+  width: 1.25rem;
+  text-align: center;
+}
+
+.navigation-menu .p-menuitem-text {
+  flex: 1;
+  font-weight: 500;
+}
+
+.navigation-menu .p-badge {
+  margin-left: auto;
+}
+
+/* Logout Section */
+.logout-section {
+  margin-top: auto;
+  padding-top: 1rem;
+  border-top: 1px solid var(--border-color);
+}
+
+.logout-button {
+  width: 100%;
+  justify-content: center;
+}
+
+/* Main Content */
+.layout-main {
+  margin-left: var(--sidebar-width);
+  margin-top: var(--topbar-height);
+  min-height: calc(100vh - var(--topbar-height));
+  transition: var(--transition);
+}
+
+.layout-content {
+  padding: 2rem;
+}
+
+.layout-mask {
+  position: fixed;
+  top: 0;
+  left: 0;
+  width: 100%;
+  height: 100%;
+  background: rgba(0, 0, 0, 0.5);
+  z-index: 998;
+  opacity: 0;
+  visibility: hidden;
+  transition: var(--transition);
+}
+
+.layout-mask-active {
+  opacity: 1;
+  visibility: visible;
+}
+
+/* Access Denied */
+.access-denied {
+  display: flex;
+  justify-content: center;
+  align-items: center;
+  min-height: 50vh;
+}
+
+.access-denied .p-card {
+  max-width: 400px;
+  text-align: center;
+}
+
+/* Dashboard Content */
+.dashboard-content {
+  max-width: 1200px;
+  margin: 0 auto;
+}
+
+.welcome-section {
+  text-align: center;
+  margin-bottom: 3rem;
+}
+
+.dashboard-title {
+  font-size: 2.5rem;
+  font-weight: 700;
+  color: var(--text-color);
+  margin-bottom: 1rem;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  gap: 0.5rem;
+}
+
+.dashboard-subtitle {
+  font-size: 1.1rem;
+  color: #6b7280;
+  margin: 0;
+}
+
+/* Quick Access Grid */
+.quick-access-grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
+  gap: 1.5rem;
+  margin-bottom: 2rem;
+}
+
+.quick-access-card {
+  cursor: pointer;
+  transition: var(--transition);
+}
+
+.quick-access-card:hover {
+  transform: translateY(-2px);
+}
+
+.quick-access-card.card-hidden {
+  display: none;
+}
+
+.quick-card {
+  border: 1px solid var(--border-color);
+  transition: var(--transition);
+  height: 100%;
+}
+
+.quick-card:hover {
+  border-color: var(--primary-color);
+  box-shadow: 0 4px 20px 0 rgba(59, 130, 246, 0.15);
+}
+
+.card-content {
+  display: flex;
+  align-items: center;
+  gap: 1rem;
+  padding: 1rem;
+}
+
+.card-icon {
+  flex-shrink: 0;
+  width: 4rem;
+  height: 4rem;
+  border-radius: 0.75rem;
+  background: linear-gradient(135deg, var(--primary-color), #1d4ed8);
+  color: white;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+}
+
+.card-info {
+  flex: 1;
+}
+
+.card-info h3 {
+  margin: 0 0 0.5rem 0;
+  font-size: 1.1rem;
+  font-weight: 600;
+  color: var(--text-color);
+}
+
+/* Stats Section */
+.stats-section {
+  margin-top: 3rem;
+}
+
+.stats-card {
+  border: 1px solid var(--border-color);
+  transition: var(--transition);
+}
+
+.stats-card:hover {
+  transform: translateY(-2px);
+  box-shadow: var(--shadow);
+}
+
+.stat-content {
+  display: flex;
+  align-items: center;
+  gap: 1rem;
+  padding: 1rem;
+}
+
+.stat-icon {
+  width: 3rem;
+  height: 3rem;
+  border-radius: 0.75rem;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  flex-shrink: 0;
+}
+
+.stat-icon i {
+  font-size: 1.5rem;
+}
+
+.stat-info {
+  flex: 1;
+}
+
+.stat-info h3 {
+  margin: 0 0 0.25rem 0;
+  font-size: 0.9rem;
+  color: #6b7280;
+  font-weight: 500;
+}
+
+.stat-number {
+  margin: 0;
+  font-size: 1.5rem;
+  font-weight: 700;
+  color: var(--text-color);
+}
+
+/* Responsive Design */
+@media (max-width: 768px) {
+  .layout-topbar {
+    padding: 0 1rem;
+  }
+  
+  .layout-topbar-menu-button {
+    display: block;
+  }
+  
+  .user-info {
+    display: none;
+  }
+  
+  .layout-sidebar {
+    transform: translateX(-100%);
+    width: 100%;
+    max-width: 320px;
+  }
+  
+  .layout-sidebar-active {
+    transform: translateX(0);
+  }
+  
+  .layout-main {
+    margin-left: 0;
+  }
+  
+  .layout-main-mobile-active {
+    margin-left: 0;
+  }
+  
+  .layout-content {
+    padding: 1rem;
+  }
+  
+  .dashboard-title {
+    font-size: 2rem;
+  }
+  
+  .quick-access-grid {
+    grid-template-columns: 1fr;
+    gap: 1rem;
+  }
+  
+  .welcome-section {
+    margin-bottom: 2rem;
+  }
+}
+
+@media (max-width: 480px) {
+  .layout-topbar {
+    padding: 0 0.5rem;
+  }
+  
+  .layout-topbar-title {
+    font-size: 1.2rem;
+  }
+  
+  .layout-content {
+    padding: 0.5rem;
+  }
+  
+  .dashboard-title {
+    font-size: 1.5rem;
+  }
+  
+  .card-content {
+    padding: 0.75rem;
+  }
+  
+  .card-icon {
+    width: 3rem;
+    height: 3rem;
+  }
+  
+  .card-icon i {
+    font-size: 1.5rem;
+  }
+}
+
+/* Dark mode support */
+@media (prefers-color-scheme: dark) {
+  :root {
+    --surface-color: #1f2937;
+    --text-color: #f9fafb;
+    --border-color: #374151;
+    --hover-color: #374151;
+  }
 }
